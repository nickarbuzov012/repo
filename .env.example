# =============================================================================
# Application
# =============================================================================
APP_PORT=3000                                             # [Optional] default: 3000 - HTTP server port

# =============================================================================
# PostgreSQL
# =============================================================================
DATABASE_HOST=localhost                                   # [Required] - PostgreSQL host
DATABASE_PORT=5432                                        # [Required] - PostgreSQL port
DATABASE_USER=postgres                                    # [Required] - PostgreSQL user
DATABASE_PASSWORD=postgres                                # [Required] - PostgreSQL password
DATABASE_NAME=users_api                                   # [Required] - PostgreSQL database name

# =============================================================================
# pgAdmin
# =============================================================================
PGADMIN_PORT=5050                                         # [Optional] default: 5050 - pgAdmin web UI port
PGADMIN_DEFAULT_EMAIL=admin@example.com                   # [Required] - pgAdmin login email
PGADMIN_DEFAULT_PASSWORD=admin                            # [Required] - pgAdmin login password

# =============================================================================
# JWT
# =============================================================================
JWT_ACCESS_SECRET=access                                  # [Required] - access token signing secret
JWT_REFRESH_SECRET=refresh                                # [Required] - refresh token signing secret
JWT_ACCESS_TTL=5m                                         # [Optional] default: 5m - access token TTL
JWT_REFRESH_TTL=7d                                        # [Optional] default: 7d - refresh token TTL

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost                                      # [Required] - Redis host for cache and queues
REDIS_PORT=6379                                           # [Required] - Redis port for cache and queues

# =============================================================================
# MinIO / S3
# =============================================================================
MINIO_ENDPOINT=http://localhost:9000                      # [Required] - S3-compatible endpoint
MINIO_CONSOLE_PORT=9001                                   # [Optional] default: 9001 - MinIO console port
MINIO_ACCESS_KEY=minio                                    # [Required] - S3 access key
MINIO_SECRET_KEY=minio-secret                             # [Required] - S3 secret key
MINIO_BUCKET=avatars                                      # [Required] - avatar bucket name
MINIO_REGION=us-east-1                                    # [Optional] default: us-east-1 - S3 region

# =============================================================================
# Admin Seed
# =============================================================================
ADMIN_LOGIN=admin                                         # [Required] - initial admin login
ADMIN_EMAIL=admin@example.com                             # [Required] - initial admin email
ADMIN_PASSWORD=admin123                                   # [Required] - initial admin password
ADMIN_AGE=30                                              # [Required] - initial admin age
ADMIN_DESCRIPTION=System administrator                    # [Required] - initial admin profile description
