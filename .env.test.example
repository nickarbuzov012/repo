# =============================================================================
# Application
# =============================================================================
NODE_ENV=test                                             # [Required] - enables test runtime behavior
APP_PORT=3001                                             # [Optional] default: 3001 - test HTTP server port

# =============================================================================
# PostgreSQL
# =============================================================================
DATABASE_HOST=localhost                                   # [Required] - test PostgreSQL host
DATABASE_PORT=5433                                        # [Required] - test PostgreSQL port
DATABASE_USER=postgres                                    # [Required] - test PostgreSQL user
DATABASE_PASSWORD=postgres                                # [Required] - test PostgreSQL password
DATABASE_NAME=users_api_test                              # [Required] - test PostgreSQL database name

# =============================================================================
# JWT
# =============================================================================
JWT_ACCESS_SECRET=test-access-secret                      # [Required] - test access token signing secret
JWT_REFRESH_SECRET=test-refresh-secret                    # [Required] - test refresh token signing secret
JWT_ACCESS_TTL=5m                                         # [Optional] default: 5m - access token TTL
JWT_REFRESH_TTL=7d                                        # [Optional] default: 7d - refresh token TTL

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost                                      # [Required] - Redis host for test cache and queues
REDIS_PORT=6379                                           # [Required] - Redis port for test cache and queues

# =============================================================================
# MinIO / S3
# =============================================================================
MINIO_ENDPOINT=http://localhost:9000                      # [Required] - test S3-compatible endpoint
MINIO_ACCESS_KEY=minio                                    # [Required] - test S3 access key
MINIO_SECRET_KEY=minio-secret                             # [Required] - test S3 secret key
MINIO_BUCKET=avatars-test                                 # [Required] - test avatar bucket name
MINIO_REGION=us-east-1                                    # [Optional] default: us-east-1 - S3 region
